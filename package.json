{
  "name": "@ezpzai/cdx",
  "version": "1.0.5",
  "description": "Use Codex more easily, even away from your desk.",
  "type": "module",
  "files": [
    "dist-cli",
    "README.md",
    "LICENSE",
    "assets/social-preview.png"
  ],
  "bin": {
    "cdx": "dist-cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezpzai/cdx.git"
  },
  "bugs": {
    "url": "https://github.com/ezpzai/cdx/issues"
  },
  "homepage": "https://github.com/ezpzai/cdx#readme",
  "keywords": [
    "codex",
    "cli",
    "remote",
    "multi-account",
    "agents"
  ],
  "license": "Apache-2.0",
  "author": "ezpzai",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.5.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0"
  }
}
