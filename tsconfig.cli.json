{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cli.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "./dist-cli",
    "rootDir": "./src-cli",
    "declaration": false,
    "sourceMap": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force"
  },
  "include": ["src-cli/**/*.ts"]
}
